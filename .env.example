# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Painel Supabase > Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# Senha de acesso ao app (tela de login). Deixe vazio para desativar o login.
APP_PASSWORD=

# Porta do servidor (padrao 3000). No VPS use uma porta livre.
PORT=3000
